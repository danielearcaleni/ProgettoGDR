classDiagram
direction TB
    class SelezionePersonaggio {
	    +MostraPersonaggiDisponibili()
    }

    class Grafica {
	    +mostraPersonaggioScelto(Personaggio personaggio)
    }

    class Oggetto {
	    -String nome
	    -String effetto
	    Oggetto(String nome, String effetto)
	    +usa()
    }

    class Gestore {
	    -int n_Turno
	    -int punteggio
	    Gestore(int n_Turno, int punteggio)
	    +generaIncontro(Incontro incontro)
	    +aggiungiPunteggio()
	    +rimuoviPunteggio()
    }

    class Personaggio {
	    -String nome
	    -int attack
	    -int salute
	    -int fame
	    -int sete
	    Personaggio(String nome, int salute, int fame, int sete)
	    +aumentaAttacco()
	    +bevi()
	    +mangia()
	    +abilitàSpeciale()
	    +perdiVita()
	    +recuperaVita()
    }

    class Incontro {
	    -String tipoIncontro
	    Incontro(String tipoIncontro)
    }

    class Enemy {
	    -String nome
	    -int salute
	    -boolean perdiOggetto
	    -String oggettoPerso
	    -int danno
	    Enemy(String nome, int salute, int danno)
	    +attack()
	    +perdiSalute()
    }

    Gestore ..> Personaggio
    Gestore ..> Grafica
    SelezionePersonaggio "1" --> "1" Personaggio
    Enemy --|> Incontro
    Oggetto --|> Incontro
    Gestore ..> Incontro